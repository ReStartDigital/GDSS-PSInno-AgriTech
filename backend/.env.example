# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# DATABASES & INFRASTRUCTURE
# ==========================================

# PostgreSQL + PostGIS
# Use service name 'postgis' for Docker, 'localhost' for local development
DB_URL=postgres://admin:secret@postgis:5432/spatial_db
DB_SSL=false

# Redis (Streams, BullMQ, & Cache)
# Use service name 'redis' for Docker, 'localhost' for local development
REDIS_URL=redis://redis:6379

# ==========================================
# AUTHENTICATION (Passport.js + JWT)
# ==========================================
# Generate a secure string with: openssl rand -base64 32
JWT_SECRET_KEY=your_super_secret_jwt_key_2026
JWT_EXPIRES_IN=1d

# ==========================================
# GEOSPATIAL SETTINGS
# ==========================================
# Default radius for proximity searches (in meters)
DEFAULT_SEARCH_RADIUS=5000
# Max spatial precision for coordinates
COORDINATE_PRECISION=6

# ==========================================
# THIRD-PARTY SERVICES
# ==========================================
# Twilio Cloud Messaging (For Geofenced Push Notifications)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# LOGGING & MONITORING
# ==========================================
# Options: error, warn, info, http, debug
LOG_LEVEL=debug
# Set to 'true' to log SQL queries to console
LOG_SQL_QUERIES=true

AKRESEL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx