# ==============================================================================
# SERVER & ENVIRONMENT CONFIGURATION
# ==============================================================================
NODE_ENV=development
PORT=3000
TIMEZONE_GHANA=Africa/Accra

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# DATABASES & INFRASTRUCTURE
# ==============================================================================
# PostgreSQL + PostGIS (Use service name 'postgis' for Docker, 'localhost' for local dev)
DB_URL=postgres://vegelink:secret@localhost:5432/vegelink_dev
DB_SSL=false

# Redis Streams, BullMQ, & Caching (Use service name 'redis' for Docker, 'localhost' for local dev)
REDIS_URL=redis://localhost:6379

# ==============================================================================
# AUTHENTICATION & SECURITY LIFECYCLES
# ==============================================================================
# Token Cryptographic Keys
JWT_SECRET_KEY=your_super_secret_jwt_key_2026
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# OTP Verification Controls (Arkesel Sync Flow)
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRY_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=3
AUTH_OTP_COOLDOWN_SECONDS=60

# Registration & Active Session Lifecycles
AUTH_REG_TOKEN_EXPIRY_SECONDS=300       # Expiry for the 5-min post-OTP state token
AUTH_ACCESS_TOKEN_EXPIRY=15m            # Express-jwt string format
AUTH_REFRESH_TOKEN_EXPIRY=7d            # Express-jwt string format
AUTH_REFRESH_TOKEN_EXPIRY_SECONDS=604800 # 7 days in numeric format for Redis/Cookies TTL
AUTH_UNVERIFIED_USER_TTL_HOURS=24       # Expiry threshold for unverified row purges

# Credential Restraints
AUTH_PIN_MIN_LENGTH=4
AUTH_PIN_MAX_LENGTH=6

# ==============================================================================
# RATE LIMITING GATEWAYS
# ==============================================================================
# Authentication & Sensitive Gateways (Anti-SMS Flooding)
RATE_LIMIT_AUTH_WINDOW_MS=900000        # 15 minutes
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Application Resource Gateways (General CRUD / Listings API)
RATE_LIMIT_GEN_WINDOW_MS=900000         # 15 minutes
RATE_LIMIT_GEN_MAX_REQUESTS=100

# ==============================================================================
# THIRD-PARTY TELECOM & PAYMENT GATEWAYS
# ==============================================================================
# Paystack (Ghana MoMo Split Payments Engine)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=...
PAYSTACK_VIRTUAL_EMAIL_DOMAIN=vegelink.app

# Arkesel SMS Gateway & Offline OTP Webhooks
ARKESEL_API_KEY=...
ARKESEL_SENDER_ID=VegeLink
ARKESEL_INBOUND_WEBHOOK_SECRET=...
ARKESEL_IP_WHITELIST=41.242.116.0/24

# Cloudinary CDN Asset Storage
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ==============================================================================
# GEOSPATIAL, LOGISTICS, & WORKER CRONS
# ==============================================================================
# Spatial Calculations (PostGIS Engine)
DEFAULT_SEARCH_RADIUS_METERS=5000
COORDINATE_PRECISION=6

# Logistics Routing Pricing Matrix
TRANSPORT_RATE_PER_KM_GHS=2.50
TRANSPORT_MATCH_RADIUS_KM=15

# System Background Worker Schedulers
CRON_DIGEST_SCHEDULE=0 18 * * * # 6pm daily summary SMS digest
CRON_EXPIRY_SCHEDULE=*/15 * * * * # Every 15 minutes clean up expired states
CRON_RESET_SCHEDULE=0 0 * * * # Midnight counter reset

# Logging Output Verbosity
LOG_LEVEL=debug
LOG_SQL_QUERIES=true