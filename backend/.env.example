# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================================
# DATABASES & INFRASTRUCTURE
# ==========================================

# PostgreSQL + PostGIS
# Use service name 'postgis' for Docker, 'localhost' for local development
DB_URL=postgres://vegelink:secret@localhost:5432/vegelink_dev
DB_SSL=false

# Redis (Streams, BullMQ, & Cache)
# Use service name 'redis' for Docker, 'localhost' for local development
REDIS_URL=redis://redis:6379

# ==========================================
# AUTHENTICATION (Passport.js + JWT)
# ==========================================
# Generate a secure string with: openssl rand -base64 32
JWT_SECRET_KEY=your_super_secret_jwt_key_2026
JWT_EXPIRES_IN=1d
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ==========================================
# GEOSPATIAL SETTINGS
# ==========================================
# Default radius for proximity searches (in meters)
DEFAULT_SEARCH_RADIUS=5000
# Max spatial precision for coordinates
COORDINATE_PRECISION=6

# ==========================================
# LOGGING & MONITORING
# ==========================================
# Options: error, warn, info, http, debug
LOG_LEVEL=debug
# Set to 'true' to log SQL queries to console
LOG_SQL_QUERIES=true

# ── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_WEBHOOK_SECRET=...

# ── Arkesel ─────────────────────────────────────────────────────────────────
AKRESEL_API_KEY=...
ARKESEL_SENDER_ID=VegeLink
ARKESEL_INBOUND_WEBHOOK_SECRET=...
ARKESEL_IP_WHITELIST=41.242.116.0/24   # Arkesel's documented IP range

# ── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# ── Virtual email domain (Paystack) ─────────────────────────────────────────
VIRTUAL_EMAIL_DOMAIN=vegelink.app

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000       # 15 minutes
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=5

# ── Jobs ────────────────────────────────────────────────────────────────────
DIGEST_CRON_SCHEDULE=0 18 * * *   # 6pm daily
EXPIRY_CRON_SCHEDULE=*/15 * * * * # Every 15 minutes
RESET_CRON_SCHEDULE=0 0 * * *     # Midnight daily
GHANA_TIMEZONE=Africa/Accra

# ── Transport cost ───────────────────────────────────────────────────────────
TRANSPORT_RATE_PER_KM_GHS=2.50
TRANSPORT_MATCH_RADIUS_KM=15