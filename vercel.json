{
  "builds": [
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "web/dist/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "web/dist/favicon.svg"
    },
    {
      "src": "/icons.svg",
      "dest": "web/dist/icons.svg"
    },
    {
      "src": "/(.*)",
      "dest": "web/dist/index.html"
    }
  ]
}
